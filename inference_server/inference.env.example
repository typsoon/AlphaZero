# Inference server configuration (loaded by the systemd unit as an
# EnvironmentFile). One file per game: inference-connect4.env / inference-chess.env.
# Every server argument is configurable here; unset optional vars fall back to
# the binary's own defaults.

# Path to the scripted network file to serve (required).
NETWORK_PATH={HOME_DIR}/.config/alphazero/models/default.pt

# Inference device: cuda or cpu.
DEVICE=cpu

# MCTS search depth (simulations per move) and inference batch size.
MCTS_SEARCH_DEPTH=800
MCTS_BATCH_SIZE=1

# Chess only, ignored for connect4: input encoding for the served net.
#   0 (or empty) = 19-plane ChessEncoderV1 (v1 / chess_v2 non-history nets)
#   1 / 4 / 8    = ChessEncoderV2History(N) for a history-encoder net
# Must match the encoding the network was trained with.
CHESS_ENCODER_HISTORY=0

# Optional: pin the Unix socket path. Leave empty to auto-generate one under
# /tmp/alphazero-inference-AZ123/<game>/<network_name>/<uuid>.sock.
SOCKET=
