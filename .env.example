# Machine-local overrides, loaded by dodo.py's load_dotenv() at startup.
# Copy this file to .env (gitignored) and edit for your machine. Unset
# variables fall back to dodo.py's own defaults, which target the original
# z1201659 training machine and may not exist on yours.

# nvcc path. dodo.py's default is /usr/local/cuda/bin/nvcc; on Arch with the
# `cuda` pacman package it's /opt/cuda/bin/nvcc instead.
ALPHAZERO_CUDA_COMPILER=/opt/cuda/bin/nvcc

# Path to a TensorRT SDK's include/ dir (containing NvInfer.h), used to build
# native raw-TensorRT-engine loading (ALPHAZERO_NATIVE_TRT_ENGINE - see
# engine/inference/CMakeLists.txt). Only takes effect when this header set's
# major version matches the active venv's pip `tensorrt` runtime major
# version. Requires downloading the TensorRT C++ SDK from
# https://developer.nvidia.com/tensorrt/download (NVIDIA account + EULA;
# not available via pacman/AUR without the same gate).
ALPHAZERO_TENSORRT_INCLUDE_DIR=/home/youruser/tensorrt_sdk/TensorRT-10.9.0.34/include

# hist_run/ (chess history-encoder bootstrap cron + restart loop) venv paths -
# only relevant on the machine that runs those scripts.
# ALPHAZERO_HIST_VENV_ACTIVATE=/mnt/storage/users/youruser/.14_ml_venv/bin/activate
# ALPHAZERO_HIST_VENV_SITE_PACKAGES=/mnt/storage/users/youruser/.14_ml_venv/lib/python3.14/site-packages
